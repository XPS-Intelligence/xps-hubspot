{
  "name": "xps-hubspot",
  "version": "1.0.0",
  "description": "Production-ready async scraping system with Playwright, Supabase, OpenAI, and HubSpot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "worker": "node dist/worker/index.js",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/worker/index.ts",
    "lint": "eslint src/**/*.ts --ext .ts",
    "lint:fix": "eslint src/**/*.ts --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node src/db/migrate.ts",
    "scrape": "ts-node src/worker/run-scrape.ts"
  },
  "dependencies": {
    "@hubspot/api-client": "^11.2.0",
    "@supabase/supabase-js": "^2.39.7",
    "@types/supertest": "^7.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "openai": "^4.28.4",
    "p-limit": "^5.0.0",
    "p-queue": "^6.6.2",
    "p-retry": "^4.1.0",
    "playwright": "^1.42.1",
    "supertest": "^7.2.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.24",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "scraping",
    "playwright",
    "hubspot",
    "supabase",
    "openai",
    "typescript"
  ],
  "author": "XPS Intelligence",
  "license": "MIT"
}
