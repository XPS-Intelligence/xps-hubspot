{
  "name": "HubSpot CRM Sync Flow",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 4 }] }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300],
      "id": "node-schedule"
    },
    {
      "parameters": {
        "path": "hubspot-sync",
        "httpMethod": "POST"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 460],
      "id": "node-webhook"
    },
    {
      "parameters": {
        "url": "={{ $env.XPS_API_URL }}/leads",
        "method": "GET",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "queryParameters": {
          "parameters": [
            { "name": "status", "value": "validated" },
            { "name": "pageSize", "value": "100" }
          ]
        }
      },
      "name": "Get Validated Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 380],
      "id": "node-get-leads"
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "name": "Split Into Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 380],
      "id": "node-split"
    },
    {
      "parameters": {
        "url": "={{ $env.XPS_API_URL }}/hubspot/sync/{{ $json.id }}",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "name": "Sync Lead to HubSpot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 380],
      "id": "node-sync-lead"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.success }}",
              "operation": "equal",
              "value2": "true"
            }
          ]
        }
      },
      "name": "Sync Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1120, 380],
      "id": "node-check-sync"
    },
    {
      "parameters": {
        "content": "={{ 'Synced lead ' + $json.data.hubspotContactId + ' successfully' }}",
        "logLevel": "info"
      },
      "name": "Log Success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 280],
      "id": "node-log-success"
    },
    {
      "parameters": {
        "content": "={{ 'Sync failed for lead: ' + $json.error }}",
        "logLevel": "warning"
      },
      "name": "Log Failure",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1340, 480],
      "id": "node-log-failure"
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Get Validated Leads", "type": "main", "index": 0 }]] },
    "Webhook Trigger": { "main": [[{ "node": "Get Validated Leads", "type": "main", "index": 0 }]] },
    "Get Validated Leads": { "main": [[{ "node": "Split Into Items", "type": "main", "index": 0 }]] },
    "Split Into Items": { "main": [[{ "node": "Sync Lead to HubSpot", "type": "main", "index": 0 }]] },
    "Sync Lead to HubSpot": { "main": [[{ "node": "Sync Successful?", "type": "main", "index": 0 }]] },
    "Sync Successful?": {
      "main": [
        [{ "node": "Log Success", "type": "main", "index": 0 }],
        [{ "node": "Log Failure", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
